
const chart3 = {
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Food Consumption Across Australian States",
    "subtitle": "Percentage of people aged 2+ consuming each food group, 2011–12",
    "fontSize": 18,
    "subtitleFontSize": 12
  },

  "width": 560,
  "height": 280,

  "data": {
    "url": "Datasets V2/food_consumption_2011.csv"
  },

  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 4,
        "stroke": "white",
        "strokeWidth": 3
      },

      "encoding": {
        "x": {
          "field": "state",
          "type": "nominal",
          "title": "State",
          "sort": ["NSW", "VIC", "SA", "NT"]
        },

        "y": {
          "field": "food_group",
          "type": "nominal",
          "title": null,
          "sort": [
            "Cereals and cereal products",
            "Milk products and dishes",
            "Vegetable products and dishes",
            "Fruit products and dishes"
          ]
        },

        "color": {
          "field": "percentage",
          "type": "quantitative",
          "scale": {
            "scheme": "greens",
            "domain": [0, 100]
          },
          "legend": {
            "title": "People (%)"
          }
        },

        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "food_group", "title": "Food group"},
          {
            "field": "percentage",
            "title": "People (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold"
      },

      "encoding": {
        "x": {
          "field": "state",
          "type": "nominal",
          "sort": ["NSW", "VIC", "SA", "NT"]
        },

        "y": {
          "field": "food_group",
          "type": "nominal",
          "sort": [
            "Cereals and cereal products",
            "Milk products and dishes",
            "Vegetable products and dishes",
            "Fruit products and dishes"
          ]
        },

        "text": {
          "field": "percentage",
          "type": "quantitative",
          "format": ".0f"
        },

        "color": {
          "condition": {
            "test": "datum.percentage >= 65",
            "value": "white"
          },
          "value": "#25352d"
        }
      }
    }
  ],

  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "grid": false
    }
  }
};

vegaEmbed("#chart3", chart3, {
  actions: false
}).catch(console.error);