const chart5 = {
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Victoria vs the State and Territory Average",
    "subtitle": "Difference in food-group consumption, percentage points",
    "fontSize": 18,
    "subtitleFontSize": 12
  },

  "width": 540,
  "height": 360,

  "data": {
    "url": "Datasets V2/food_consumption_2011.csv",
    "format": {
      "type": "csv",
      "parse": {
        "state": "string",
        "food_group": "string",
        "percentage": "number"
      }
    }
  },

  "transform": [
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "percentage",
          "as": "StateAverage"
        }
      ],
      "groupby": ["food_group"]
    },
    {
      "filter": "datum.state == 'VIC'"
    },
    {
      "calculate": "datum.percentage - datum.StateAverage",
      "as": "Difference"
    },
    {
      "calculate": "datum.Difference >= 0 ? 'Above average' : 'Below average'",
      "as": "Direction"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#444444",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {"datum": 0}
      }
    },
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "size": 24
      },
      "encoding": {
        "x": {
          "field": "Difference",
          "type": "quantitative",
          "title": "Difference (percentage points)",
          "scale": {
            "domain": [-10, 10]
          },
          "axis": {
            "grid": true,
            "gridColor": "#eeeeee"
          }
        },

        "y": {
          "field": "food_group",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "Difference",
            "order": "descending"
          },
          "axis": {
            "labelLimit": 250,
            "labelFontSize": 11
          }
        },

        "color": {
          "field": "Direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Above average",
              "Below average"
            ],
            "range": [
              "#287c4b",
              "#d97c55"
            ]
          },
          "legend": {
            "title": "Victoria"
          }
        },

        "tooltip": [
          {
            "field": "food_group",
            "title": "Food group"
          },
          {
            "field": "percentage",
            "title": "Victoria (%)",
            "format": ".1f"
          },
          {
            "field": "StateAverage",
            "title": "Eight-state mean (%)",
            "format": ".1f"
          },
          {
            "field": "Difference",
            "title": "Difference (pp)",
            "format": "+.2f"
          }
        ]
      }
    }
  ],

  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false
    }
  }
};

vegaEmbed("#chart5", chart5, {
  actions: false
}).catch(console.error);